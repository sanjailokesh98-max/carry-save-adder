VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN csa ;
UNITS DISTANCE MICRONS 1000 ;
PROPERTYDEFINITIONS
COMPONENTPIN ACCESS_DIRECTION STRING ;
END PROPERTYDEFINITIONS
DIEAREA ( 0 0 ) ( 0 11000 ) ( 11028 11000 ) ( 11028 0 ) ;
ROW unit_row_1 unit 1000 1000 FS DO 122 BY 1 STEP 74 0 ;
ROW unit_row_2 unit 1000 1600 N DO 122 BY 1 STEP 74 0 ;
ROW unit_row_3 unit 1000 2200 FS DO 122 BY 1 STEP 74 0 ;
ROW unit_row_4 unit 1000 2800 N DO 122 BY 1 STEP 74 0 ;
ROW unit_row_5 unit 1000 3400 FS DO 122 BY 1 STEP 74 0 ;
ROW unit_row_6 unit 1000 4000 N DO 122 BY 1 STEP 74 0 ;
ROW unit_row_7 unit 1000 4600 FS DO 122 BY 1 STEP 74 0 ;
ROW unit_row_8 unit 1000 5200 N DO 122 BY 1 STEP 74 0 ;
ROW unit_row_9 unit 1000 5800 FS DO 122 BY 1 STEP 74 0 ;
ROW unit_row_10 unit 1000 6400 N DO 122 BY 1 STEP 74 0 ;
ROW unit_row_11 unit 1000 7000 FS DO 122 BY 1 STEP 74 0 ;
ROW unit_row_12 unit 1000 7600 N DO 122 BY 1 STEP 74 0 ;
ROW unit_row_13 unit 1000 8200 FS DO 122 BY 1 STEP 74 0 ;
ROW unit_row_14 unit 1000 8800 N DO 122 BY 1 STEP 74 0 ;
ROW unit_row_15 unit 1000 9400 FS DO 122 BY 1 STEP 74 0 ;
TRACKS Y 38 DO 149 STEP 74 LAYER M1 ;
TRACKS X 38 DO 149 STEP 74 LAYER M1 ;
TRACKS Y 40 DO 183 STEP 60 LAYER M2 ;
TRACKS X 40 DO 184 STEP 60 LAYER M2 ;
TRACKS Y 38 DO 149 STEP 74 LAYER M3 ;
TRACKS X 38 DO 149 STEP 74 LAYER M3 ;
TRACKS Y 0 DO 111 STEP 100 LAYER M4 ;
TRACKS X 0 DO 111 STEP 100 LAYER M4 ;
TRACKS Y 0 DO 111 STEP 100 LAYER M5 ;
TRACKS X 0 DO 111 STEP 100 LAYER M5 ;
TRACKS Y 0 DO 111 STEP 100 LAYER M6 ;
TRACKS X 0 DO 111 STEP 100 LAYER M6 ;
TRACKS Y 0 DO 111 STEP 100 LAYER M7 ;
TRACKS X 0 DO 111 STEP 100 LAYER M7 ;
TRACKS Y 0 DO 111 STEP 100 LAYER M8 ;
TRACKS X 0 DO 111 STEP 100 LAYER M8 ;
TRACKS Y 0 DO 111 STEP 100 LAYER M9 ;
TRACKS X 0 DO 111 STEP 100 LAYER M9 ;
TRACKS Y 1000 DO 3 STEP 4000 LAYER MRDL ;
TRACKS X 1000 DO 3 STEP 4000 LAYER MRDL ;
VIAS 1 ;
 - VIA4BAR1_C_2_2 + VIARULE VIA4BAR1_C
   + CUTSIZE 90 50
   + LAYERS M4 VIA4 M5
   + CUTSPACING 50 50
   + ENCLOSURE 5 5 5 5
   + ROWCOL 2 2
   + PATTERN 2_C ;
END VIAS
NONDEFAULTRULES 1 ;
 - 2w2s
   + HARDSPACING
   + LAYER M1 WIDTH 68 SPACING 52
   + LAYER M2 WIDTH 68 SPACING 52
   + LAYER M3 WIDTH 68 SPACING 52
   + LAYER M4 WIDTH 120 SPACING 80
   + LAYER M5 WIDTH 120 SPACING 80
   + LAYER M6 WIDTH 120 SPACING 80
   + LAYER M7 WIDTH 120 SPACING 80
   + LAYER M8 WIDTH 120 SPACING 80
   + LAYER M9 WIDTH 120 SPACING 80
   + LAYER MRDL WIDTH 2000 SPACING 2000 ;
END NONDEFAULTRULES
